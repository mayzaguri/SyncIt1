<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mytrip"
    android:layoutDirection="rtl"
    tools:context=".MyTripsActivity">

    <!-- כותרת -->
    <TextView
        android:id="@+id/tvMyTripsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="הטיולים שלי ✈"
        android:textColor="#075985"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- כותרת משנה -->
    <TextView
        android:id="@+id/tvMyTripsSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="כל ההרפתקאות שלך במקום אחד"
        android:textColor="#28749A"
        android:textSize="16sp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvMyTripsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- רשימת הטיולים -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMyTrips"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="15dp"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/tvMyTripsSubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- הודעה כשאין טיולים -->
    <TextView
        android:id="@+id/tvNoTrips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="עדיין אין לך טיולים כאן 🌍\nזה הזמן לתכנן את ההרפתקה הבאה!"
        android:textColor="#28749A"
        android:textSize="19sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        android:layout_margin="25dp"
        app:layout_constraintTop_toBottomOf="@id/tvMyTripsSubtitle"
        app:layout_constraintBottom_toTopOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- חץ חזרה כמו במסך הבית -->
    <TextView
        android:id="@+id/btnBack"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:text="◀"
        android:textColor="#1E3A8A"
        android:textSize="30sp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginLeft="15dp"
        android:layout_marginBottom="15dp" />

</androidx.constraintlayout.widget.ConstraintLayout>