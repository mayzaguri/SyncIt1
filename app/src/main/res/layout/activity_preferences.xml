<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mytrip"
    android:layoutDirection="rtl"
    tools:context=".ActivityPreferences">

    <TextView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Sync It! ✈"
        android:textColor="#075985"
        android:textSize="23sp"
        android:textStyle="bold"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvPreferencesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="בואו נתכנן את הטיול! 🌍"
        android:textColor="#075985"
        android:textSize="27sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginTop="35dp"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvPreferencesSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="כמה שאלות קצרות שיעזרו לנו להתאים את הטיול להעדפות שלך"
        android:textColor="#28749A"
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintTop_toBottomOf="@id/tvPreferencesTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvQuestionNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="שאלה 1 מתוך 9"
        android:textColor="#075985"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginTop="30dp"
        android:layout_marginStart="25dp"
        app:layout_constraintTop_toBottomOf="@id/tvPreferencesSubtitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvProgressPercent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="11%"
        android:textColor="#075985"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginEnd="25dp"
        app:layout_constraintTop_toTopOf="@id/tvQuestionNumber"
        app:layout_constraintEnd_toEndOf="parent" />

    <ProgressBar
        android:id="@+id/pbPreferencesProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="9dp"
        android:max="100"
        android:progress="11"
        android:progressTint="#0EA5E9"
        android:progressBackgroundTint="#D7EDF7"
        android:layout_marginTop="12dp"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        app:layout_constraintTop_toBottomOf="@id/tvQuestionNumber"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardQuestion"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="7dp"
        app:cardBackgroundColor="#F5FCFF"
        app:layout_constraintTop_toBottomOf="@id/pbPreferencesProgress"
        app:layout_constraintBottom_toTopOf="@id/btnNextQuestion"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="22dp"
            android:layoutDirection="rtl">

            <TextView
                android:id="@+id/tvQuestion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="איזה סוג טיול הכי מעניין אותך?"
                android:textColor="#075985"
                android:textSize="21sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp" />

            <RadioGroup
                android:id="@+id/rgAnswers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rbAnswer1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏖️ בטן-גב ומנוחה"
                    android:textColor="#28749A"
                    android:textSize="17sp"
                    android:padding="10dp" />

                <RadioButton
                    android:id="@+id/rbAnswer2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏔️ טבע ונופים"
                    android:textColor="#28749A"
                    android:textSize="17sp"
                    android:padding="10dp" />

                <RadioButton
                    android:id="@+id/rbAnswer3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏙️ עיר וקניות"
                    android:textColor="#28749A"
                    android:textSize="17sp"
                    android:padding="10dp" />

                <RadioButton
                    android:id="@+id/rbAnswer4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎢 אטרקציות והרפתקאות"
                    android:textColor="#28749A"
                    android:textSize="17sp"
                    android:padding="10dp" />

                <RadioButton
                    android:id="@+id/rbAnswer5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎭 תרבות והיסטוריה"
                    android:textColor="#28749A"
                    android:textSize="17sp"
                    android:padding="10dp" />

            </RadioGroup>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnNextQuestion"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="המשך ←"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#0EA5E9"
        android:stateListAnimator="@null"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginBottom="20dp"
        app:cornerRadius="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
