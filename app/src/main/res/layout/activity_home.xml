<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/home"
    tools:context=".HomeActivity">

    <!-- כפתור יצירת טיול -->
    <LinearLayout
        android:id="@+id/btnCreateTrip"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/trip_button"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnJoinTrip"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <TextView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/trip_icon_circle"
            android:gravity="center"
            android:text="+"
            android:textColor="#1687C9"
            android:textSize="40sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:layout_marginStart="12dp"
            android:text="יצירת טיול"
            android:textColor="#176FA6"
            android:textSize="23sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- כפתור הצטרפות לטיול -->
    <LinearLayout
        android:id="@+id/btnJoinTrip"
        android:layout_width="0dp"
        android:layout_height="100dp"
        android:layout_marginStart="28dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/trip_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnCreateTrip">

        <TextView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/trip_icon_circle"
            android:gravity="center"
            android:text="✈"
            android:textColor="#1687C9"
            android:textSize="30sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="הצטרפות לטיול"
            android:textColor="#176FA6"
            android:textSize="23sp"
            android:textStyle="bold" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
