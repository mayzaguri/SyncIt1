<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="7dp"
    app:cardBackgroundColor="#F5FCFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp"
        android:layoutDirection="rtl">

        <!-- שם הקבוצה וסטטוס -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvTripName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="שם הקבוצה"
                android:textColor="#075985"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTripStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="הפלנר מוכן"
                android:textColor="#0284C7"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#DDF3FC"
                android:padding="9dp" />

        </LinearLayout>

        <!-- יעד הטיול -->
        <TextView
            android:id="@+id/tvTripDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@android:drawable/ic_menu_mylocation"
            android:drawablePadding="10dp"
            android:text="יעד הטיול"
            android:textColor="#28749A"
            android:textSize="20sp"
            android:layout_marginTop="5dp" />

        <!-- תאריכים -->
        <TextView
            android:id="@+id/tvTripDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@android:drawable/ic_menu_my_calendar"
            android:drawablePadding="10dp"
            android:layout_marginTop="14dp"
            android:text="תאריכי הטיול"
            android:textColor="#52758A"
            android:textSize="17sp" />

        <!-- משתתפים -->
        <TextView
            android:id="@+id/tvTripMembers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawableStart="@android:drawable/ic_menu_share"
            android:drawablePadding="10dp"
            android:layout_marginTop="14dp"
            android:text="משתתפים: 1/10"
            android:textColor="#52758A"
            android:textSize="17sp" />

        <!-- קו הפרדה -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#C8E8F5"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp" />

        <!-- מעבר לפלנר -->
        <Button
            android:id="@+id/btnTripQuestionnaire"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="לצפייה בפלנר ✈️"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0EA5E9"
            android:stateListAnimator="@null"
            app:cornerRadius="15dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
